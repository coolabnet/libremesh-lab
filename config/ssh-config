Host *
  IdentitiesOnly yes
  ServerAliveInterval 10
  ServerAliveCountMax 3
  ConnectTimeout 30
  # Keep ssh-rsa for backward compatibility with older OpenWrt/dropbear
  # images that may still ship an RSA-only host key. The lab's internal
  # ssh calls (configure-vms.sh, mesh-status.sh) use inline -F to a
  # stripped config without this directive, so they are ed25519-strict.
  HostKeyAlgorithms +ssh-rsa
